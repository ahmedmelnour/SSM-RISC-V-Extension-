# ---------------------------------------------------------------------------
# Vivado project state
#
# Only the .xpr and .srcs/ of each project are kept. Everything else Vivado
# regenerates, and .runs/ alone is ~16 MB per build.
# ---------------------------------------------------------------------------
*.cache/
*.hw/
*.runs/
*.sim/
*.gen/
*.ip_user_files/
.Xil/
*.jou
*.log
*.str
vivado_pid*
*.backup.jou
*.backup.log

# ---------------------------------------------------------------------------
# Firmware build artefacts -- all reproduced by fw/build.sh
# ---------------------------------------------------------------------------
fw/*.elf
fw/*.bin
fw/*.o
fw/*.mem
fw/*.dis
fw/*.map
fw/build_info.txt

# Generated by fw/build.sh, included by rtl/a7lite_soc_top.sv.
# Holds absolute paths, so it must not be shared between machines.
build/

# ---------------------------------------------------------------------------
# Model development -- see py/README.md
#
# The venv is bootstrapped, not vendored (this machine's Python 3.10 has no
# ensurepip, so it needs the get-pip.py route). MIT-BIH is re-downloadable from
# PhysioNet with py/fetch_data.py. Between them that is ~5.2 GB.
#
# The trained checkpoints in py/data/*.pt are ignored along with the rest of the
# directory. They are small (~40 KB each) but they are not reproducible from the
# repo either -- back them up outside git.
# ---------------------------------------------------------------------------
py/venv/
py/data/
__pycache__/
*.pyc

# Generated golden vectors for the host differential test (429 KB, regenerate
# with py/export_c.py --host-beats). fw/golden.h is committed instead: it is
# small and is the exact vector set that passed the hardware gate.
py/golden_host.h

# ---------------------------------------------------------------------------
# Measurement outputs. results/gate_20260809_225054.txt is force-added as the
# evidence for the week-2 gate; everything else here is regenerated by
# scripts/run_bench.py.
# ---------------------------------------------------------------------------
results/

# ---------------------------------------------------------------------------
# Third party -- fetched, not vendored
# ---------------------------------------------------------------------------

# CV32E40X core. scripts/fetch_core.sh clones the pinned revision here.
vendor/

# Spike, built out of tree and installed to ~/tools/spike.
riscv-isa-sim/

# Rescue GUI project (regenerate with scripts/create_gui_project.tcl).
# a7lite_soc/ is the project to open normally.
vivado_gui/

# Vivado byproduct: re-dirties on every build and describes design_1, not this
# design.
clockInfo.txt

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.obsidian/
.vscode/
*~
.DS_Store
